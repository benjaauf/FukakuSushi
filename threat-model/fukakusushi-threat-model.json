            "id": "ca5ad1c0-5812-49ca-88a1-04345506175d",
            "data": {
              "type": "tm.Process",
              "name": "API Express",
              "description": "crud/app.js: rutas CRUD, login y verificación",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isTrustBoundary": false,
              "threats": [
                {
                  "id": "d047098b-0b48-4612-9ccf-ecb7cc56640f",
                  "title": "Backend sin autenticación ni autorización",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Ninguna ruta de crud/routes/* valida identidad o rol. Un anónimo puede hacer PUT /trabajadores/:rut con {rol:'admin'} o resetear la contraseña de cualquier cuenta, y leer/borrar clientes, pedidos y pagos.",
                  "mitigation": "Emitir JWT/sesión httpOnly en el login; middleware requireAuth y requireRole(admin|dueno|cajero) en todas las rutas; impedir que el cliente escriba rol/verificado.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": "57.2"
                },
                {
                  "id": "438a1631-9e84-41ed-800f-d44cbce04c2b",
                  "title": "Inyección SQL por nombres de columna",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "pago, pedido, pedidoitem, chofer, despacho, ingrediente, producto y productoingrediente concatenan Object.keys(req.body) en INSERT/UPDATE (línea ~23 y ~33). Los valores usan '?', los identificadores no.",
                  "mitigation": "Whitelist de columnas por tabla; validación de esquema con zod/joi; rechazar claves desconocidas; considerar un query builder/ORM.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": "54.4"
                },
                {
                  "id": "59e96e68-8aff-4144-b12c-7a3e013773de",
                  "title": "Login sin token ni rate limiting (fuerza bruta)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "POST /clientes/login y /trabajadores/login devuelven JSON de perfil sin emitir token verificable y sin límite de intentos; permite fuerza bruta y credential stuffing.",
                  "mitigation": "express-rate-limit y bloqueo temporal; emitir token firmado con expiración; mensajes de error uniformes; MFA para roles de personal.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": "38.5"
                },
                {
                  "id": "30bd5eb6-ab96-43f8-9752-5159839594ab",
                  "title": "Token de verificación de correo predecible",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "El token es base64url(email), sin secreto ni expiración (clientes.js:22, trabajadores.js:25). Cualquiera puede llamar GET /confirmar/<base64(email)> y marcar verificado=1 en cualquier cuenta.",
                  "mitigation": "Generar tokens con crypto.randomBytes, guardarlos hasheados con expiración y de un solo uso; invalidar tras verificar.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": "26.7"
                },
                {
                  "id": "e63d9f8e-39e1-4ae5-9a90-e09ff3906dae",
                  "title": "Credenciales por defecto en el seed",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "seed.js crea admin@, dueno@ y cajero@fukusuke.com con contraseña '123456'. Si fukusuke.db (commiteada) se usa en producción, esas cuentas privilegiadas existen.",
                  "mitigation": "Eliminar contraseñas fijas; generar credenciales aleatorias en el despliegue; forzar cambio en el primer login; no versionar la base.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": "57.2"
                },
                {
                  "id": "2e905484-b435-41a1-824e-fa6b22a289cf",
                  "title": "Sin límites de payload ni protección DoS",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "express.json() sin límite de tamaño, sin rate limiting y sin helmet; permite agotar memoria/CPU y bloquear el único proceso Node con SQLite.",
                  "mitigation": "express.json({limit:'100kb'}); rate limiting global; timeouts; reverse proxy/WAF; monitoreo de disponibilidad.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": "22.8"
                }
              ],
              "privilege": true,
              "isWebApplication": true,
              "handlesCardPayment": true,
              "handlesGoodsOrServices": true,
              "isALibrary": false,
              "providesAuthentication": true
            }
