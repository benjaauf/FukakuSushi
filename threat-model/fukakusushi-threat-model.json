                {
                  "id": "5d4414e1-117b-4edb-894a-335e2e96d586",
                  "title": "Sesión sin firmar en localStorage",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "AuthContext guarda el objeto de usuario (rol, tipo) en localStorage sin firma; cualquier script o el propio usuario puede editarlo para aparentar otro rol.",
                  "mitigation": "Usar cookie httpOnly/SameSite con token firmado por el servidor; no confiar en rol del cliente; CSP para reducir XSS.",
